<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1664</width>
    <height>1041</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>VL Flooring</string>
  </property>
  <property name="windowIcon">
   <iconset>
    <normaloff>logo_icon_only_256.png</normaloff>logo_icon_only_256.png</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ══════════════════════════════════════════════════════════════
   ESTILO GLOBAL — aplica-se a toda janela e a todo widget que não
   tenha uma regra mais específica sobrescrevendo depois.
   ══════════════════════════════════════════════════════════════ */
QMainWindow, QWidget {
    background-color: #F0F4F8;           /* cor de fundo padrão (cinza-azulado claro) */
    font-family: &quot;Segoe UI&quot;, sans-serif;  /* fonte padrão de todo o app */
    font-size: 13px;                      /* tamanho de fonte padrão */
    color: #1C2B3A;                       /* cor de texto padrão (azul bem escuro) */
}
* { border: none; outline: none; }        /* remove borda/contorno padrão de TODOS os widgets (reset) */

/* ══════════════════════════════════════════════════════════════
   SIDEBAR (Left_container) — menu lateral animado
   ══════════════════════════════════════════════════════════════ */
#Left_container {
    background-color: #1C2B3A;   /* fundo azul-marinho escuro da sidebar */
    min-width: 60px;             /* largura mínima = 60px (estado colapsado) */
    max-width: 60px;             /* largura máxima = 60px (estado colapsado) */
    margin: 0px 6px 0px 0px;     /* MUDANÇA: pequena margem só do lado direito, criando um
                                     &quot;respiro&quot; entre a sidebar e o conteúdo principal.
                                     Topo/baixo/esquerda ficam em 0 (colados na borda da janela). */
    /* IMPORTANTE: min-width e max-width devem ser IGUAIS aqui (60px).
       O Python (main_.py) controla a animação entre 60px &lt;-&gt; 200px
       via QPropertyAnimation. Se min for maior que max, os dois
       valores entram em conflito e a sidebar &quot;briga&quot; com a animação,
       causando o efeito de layout quebrado/desconfigurado. */
}
#Left_container QLabel {
    color: #FFFFFF;                          /* texto branco (contraste com fundo escuro) */
    font-size: 15px;
    font-weight: bold;
    padding: 14px 8px 10px 8px;              /* respiro em volta do texto (topo direita baixo esquerda) */
    background-color: #1C2B3A;               /* mesma cor de fundo da sidebar (sem &quot;quadradinho&quot; visível) */
    border-bottom: 1px solid #263849;        /* linha fina separando do conteúdo abaixo */
}
#Left_container QPushButton {
    background-color: transparent;   /* botão sem fundo — só aparece ao passar o mouse ou selecionar */
    color: #8AAEC8;                  /* azul claro acinzentado — cor do ícone/texto em repouso */
    text-align: left;                /* alinha texto/ícone à esquerda (não centralizado) */
    padding: 10px 0px;               /* respiro vertical entre botões */
    font-size: 13px;
    font-weight: 500;
    border: none;                    /* MUDANÇA: removida toda borda (antes tinha border-left reservado) */
    border-radius: 0px;              /* sem cantos arredondados em repouso */
    margin: 1px 0px;                 /* espaçamento mínimo entre um botão e outro */
}
#Left_container QPushButton:hover {
    background-color: #263849;             /* fundo escurece um pouco ao passar o mouse */
    color: #FFFFFF;                        /* texto/ícone fica branco (mais visível) */
    border: none;                          /* MUDANÇA: sem borda no hover também */
}
#Left_container QPushButton:checked {
    background-color: #F0F4F8;             /* MUDANÇA: agora usa a MESMA cor do QStackedWidget (Pages),
                                                fazendo o botão &quot;se fundir&quot; visualmente com o conteúdo,
                                                como se fosse uma aba grudada no painel principal */
    color: #1C2B3A;                        /* MUDANÇA: texto escuro, já que o fundo agora é claro */
    border: none;                          /* MUDANÇA: sem borda — quem indica seleção agora é a cor + o raio */
    border-top-left-radius: 8px;           /* MUDANÇA: arredonda só o canto de CIMA à esquerda */
    border-bottom-left-radius: 8px;        /* MUDANÇA: arredonda só o canto de BAIXO à esquerda */
    font-weight: 600;                      /* texto um pouco mais grosso quando selecionado */
}

/* Submenu de Registrations (Companies / Contractors / Work Types) dentro da sidebar */
#frame_registrations_submenu QPushButton {
    text-align: left;
    padding-left: 8px;
    font-size: 16px;
    background-color: rgba(255,255,255,0.03);  /* branco quase transparente — leve destaque do fundo escuro */
    border: none;
    border-radius: 4px;
}
#frame_registrations_submenu QPushButton:hover {
    background-color: rgba(255,255,255,0.08);  /* um pouco mais visível ao passar o mouse */
}
#frame_registrations_submenu QPushButton:checked {
    background-color: rgba(255,255,255,0.15);  /* ainda mais visível quando selecionado */
}

/* Botão de abrir/fechar a sidebar (☰) */
#btn_toggle { padding: 8px 0px; color: #8AAEC8; }
#btn_toggle:hover { color: #FFFFFF; background-color: #263849; }

/* ══════════════════════════════════════════════════════════════
   ÁREA PRINCIPAL (Main_container) — tudo à direita da sidebar
   ══════════════════════════════════════════════════════════════ */
#Main_container { background-color: #F0F4F8; }  /* mesmo cinza-claro do fundo geral */

/* Barra superior com o título da página + selo do usuário logado */
#Top_frame {
    background-color: #FFFFFF;             /* fundo branco, destacando do resto cinza */
    border-bottom: 1px solid #DDE4EE;      /* linha fina separando do conteúdo abaixo */
    min-height: 50px;                      /* altura fixa mínima */
    max-height: 50px;                      /* altura fixa máxima (min = max =&gt; altura travada em 50px) */
}
#Top_frame QLabel {
    color: #1C2B3A;
    font-size: 16px;
    font-weight: 600;
    padding: 0px 8px;
    background-color: transparent;
}
#lbl_user {
    color: #FFFFFF;
    background-color: #1565C0;      /* pílula azul com o nome/status do usuário */
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;            /* raio grande = formato de &quot;pílula&quot; arredondada */
}

/* Fundo da área onde as páginas (Home, Jobs, Companies...) trocam entre si */
QStackedWidget { background-color: #F0F4F8; }

/* ══════════════════════════════════════════════════════════════
   ABAS (QTabWidget) — usado em Jobs, Companies, Contractors, etc.
   ══════════════════════════════════════════════════════════════ */
QTabWidget::pane { border: none; background-color: #F0F4F8; }  /* área de conteúdo abaixo das abas */
QTabBar { background-color: #FFFFFF; border-bottom: 1px solid #DDE4EE; }  /* faixa onde ficam as abas */
QTabBar::tab {
    background-color: transparent;
    color: #6B7C93;                          /* cinza — aba não selecionada */
    padding: 12px 20px;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 2px solid transparent;    /* reserva espaço pra barrinha de &quot;aba ativa&quot; */
    border-radius: 0px;
}
QTabBar::tab:hover { color: #1C2B3A; background-color: #F5F8FC; }  /* escurece o texto ao passar o mouse */
QTabBar::tab:selected {
    color: #1565C0;                          /* azul — aba selecionada */
    border-bottom: 2px solid #1E88E5;        /* barrinha azul embaixo da aba ativa */
    font-weight: 600;
    background-color: #FFFFFF;
}

/* MUDANÇA: scroll_job_form (a área rolável do formulário de Job) usa a MESMA
   cor de fundo do QTabWidget::pane acima (#F0F4F8), pra não destacar como um
   retângulo diferente por trás dos cartões. O seletor &quot;&gt; QWidget&quot; pega só o
   viewport interno do scroll (não afeta os cartões brancos lá dentro). */
#scroll_job_form, #scroll_job_form &gt; QWidget {
    background-color: #F0F4F8;
    border: none;
}

/* MUDANÇA: garante que o FUNDO da aba &quot;New/Edit Job&quot; (por trás de todos os
   cartões) fica explicitamente nessa cor cinza-azulada — assim os cartões
   brancos (Job Info, Work Types, Client Info, Extra) &quot;flutuam&quot; visualmente
   por cima, em vez de se misturarem com o fundo. */
#tab_job_form {
    background-color: #F0F4F8;
}

/* ══════════════════════════════════════════════════════════════
   CARTÕES (QFrame) — todo cartão branco arredondado da interface
   ══════════════════════════════════════════════════════════════ */
QFrame { background-color: #FFFFFF; border-radius: 8px; }  /* fundo branco + cantos arredondados por padrão */

/* Labels de campo (ex: &quot;WORK DATE&quot;, &quot;CONTRACTOR&quot;) — texto pequeno em maiúsculo */
QLabel { color: #6B7C93; font-size: 11px; font-weight: 600; background-color: transparent; }

/* ══════════════════════════════════════════════════════════════
   CAMPOS DE ENTRADA (inputs)
   ══════════════════════════════════════════════════════════════ */
QLineEdit {
    background-color: #F5F8FC;       /* fundo cinza bem clarinho */
    color: #1C2B3A;
    border: 1px solid #CBD5E1;       /* borda cinza sutil */
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
QLineEdit:focus { border: 1px solid #1E88E5; background-color: #FFFFFF; }  /* destaca em azul quando o usuário clica no campo */
QLineEdit:disabled { background-color: #EEF2F7; color: #9BADBF; }         /* campo &quot;cinza apagado&quot; quando desabilitado */

QComboBox {
    background-color: #F5F8FC;
    color: #1C2B3A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 13px;
    min-height: 30px;                /* garante altura mínima consistente com os outros campos */
}
QComboBox:focus { border: 1px solid #1E88E5; background-color: #FFFFFF; }
QComboBox::drop-down { border: none; width: 22px; }   /* área clicável da setinha do combo */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;                      /* fundo da lista suspensa (dropdown) */
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    selection-background-color: #E3F2FD;            /* item destacado ao passar o mouse/selecionar */
    selection-color: #1565C0;
}

QTextEdit {
    background-color: #F5F8FC;
    color: #1C2B3A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
QTextEdit:focus { border: 1px solid #1E88E5; background-color: #FFFFFF; }

/* Campos numéricos (valor, quantidade) */
QDoubleSpinBox, QSpinBox {
    background-color: #F5F8FC;
    color: #1C2B3A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}
QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #1E88E5; background-color: #FFFFFF; }
QDoubleSpinBox:disabled, QSpinBox:disabled { background-color: #EEF2F7; color: #9BADBF; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 16px;                     /* largura das setinhas de incrementar/decrementar */
    border: none;
    background-color: transparent;
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #E3F2FD; }  /* destaca a setinha no hover */

/* ══════════════════════════════════════════════════════════════
   TABELAS (QTableWidget) — Job Records, Companies, Contractors...
   ══════════════════════════════════════════════════════════════ */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #DDE4EE;
    border-radius: 6px;
    gridline-color: #EEF2F7;                     /* cor das linhas divisórias entre células */
    selection-background-color: #E3F2FD;         /* cor de fundo da linha selecionada */
    selection-color: #1C2B3A;
    font-size: 13px;
}
QTableWidget::item { padding: 8px 10px; border-bottom: 1px solid #EEF2F7; }  /* respiro + linha fina entre linhas da tabela */
QTableWidget::item:selected { background-color: #E3F2FD; color: #1565C0; }  /* cor quando o usuário clica numa linha */
QHeaderView::section {
    background-color: #F5F8FC;       /* fundo do cabeçalho das colunas */
    color: #6B7C93;
    font-size: 11px;
    font-weight: 700;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #DDE4EE;    /* linha grossa separando cabeçalho do corpo da tabela */
    border-right: 1px solid #EEF2F7;     /* linha fina separando uma coluna da outra */
}

/* ══════════════════════════════════════════════════════════════
   BOTÕES (QPushButton) — estilo padrão + variações por objectName
   ══════════════════════════════════════════════════════════════ */
QPushButton {
    background-color: #F5F8FC;       /* botão padrão: cinza clarinho (ex: &quot;Refresh&quot; genérico, &quot;Cancel&quot;) */
    color: #1C2B3A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton:hover { background-color: #E3F2FD; border-color: #1E88E5; color: #1565C0; }  /* fica azulado ao passar o mouse */
QPushButton:pressed { background-color: #BBDEFB; }                                        /* mais escuro enquanto pressionado */

/* Botões &quot;+ New ...&quot; — ação primária, sempre azul forte */
#btn_new_job, #btn_user_create_user, #btn_new_company, #btn_new_contractor, #btn_new_user, #btn_update_user, #btn_new_work_type, #btn_new_expense, #btn_new_product {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 9px 20px;
    font-size: 13px;
    font-weight: 700;
}
#btn_new_job:hover, #btn_user_create_user:hover, #btn_new_company:hover, #btn_new_contractor:hover, #btn_new_user:hover, #btn_update_user:hover, #btn_new_product:hover { background-color: #1E88E5; }   /* azul mais claro no hover */
#btn_new_job:pressed, #btn_user_create_user:pressed, #btn_new_company:pressed, #btn_new_contractor:pressed, #btn_new_user:pressed, #btn_update_user:pressed, #btn_new_product:pressed { background-color: #0D47A1; }  /* azul mais escuro pressionado */

/* Botões &quot;Save&quot; — mesmo azul forte dos botões &quot;New&quot; (ação de confirmar) */
#btn_save_job, #btn_save_company, #btn_save_contractor, #btn_save_user, #btn_save_work_type, #btn_save_expense, #btn_save_product {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
}
#btn_save_job:hover, #btn_save_company:hover, #btn_save_contractor:hover, #btn_save_user:hover, #btn_save_product:hover { background-color: #1E88E5; }

/* Botões &quot;Delete&quot; — vermelho, indicando ação destrutiva */
#btn_delete_job, #btn_delete_company, #btn_delete_contractor, #btn_delete_user, #btn_delete_work_type, #btn_delete_expense, #btn_delete_product {
    background-color: #C62828;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
}
#btn_delete_job:hover, #btn_delete_company:hover, #btn_delete_contractor:hover, #btn_delete_user:hover, #btn_delete_product:hover { background-color: #E53935; }  /* vermelho mais claro no hover */

/* Botões &quot;Refresh&quot; — cinza-azulado escuro, ação secundária/neutra */
#btn_refresh_jobs, #btn_refresh_companies, #btn_refresh_contractors, #btn_refresh_users, #btn_refresh_work_types, #btn_refresh_expenses, #btn_refresh_products {
    background-color: #37474F;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
}
#btn_refresh_jobs:hover, #btn_refresh_companies:hover, #btn_refresh_contractors:hover, #btn_refresh_users:hover, #btn_refresh_products:hover { background-color: #546E7A; }

/* ══════════════════════════════════════════════════════════════
   CABEÇALHOS DE CARTÃO (a faixa azul no topo de cada cartão,
   com o título tipo &quot;Job Info&quot;, &quot;Client Info&quot;, &quot;Work Types&quot;...)
   ══════════════════════════════════════════════════════════════ */
#card_header_jobs, #card_header_company, #card_header_contractor, #card_header_user, #card_header_work_type, #card_header_job_info, #card_header_client_info, #card_header_work_types, #card_header_materials, #card_header_expense {
    background-color: #FFFFFF;             /* MUDANÇA: fundo branco, igual ao resto do cartão (sem faixa colorida) */
    border-radius: 0px;
    border-top-left-radius: 8px;           /* arredonda só os cantos de CIMA (mantém o mesmo raio do cartão) */
    border-top-right-radius: 8px;
    max-height: 56px;                      /* altura fixa da faixa */
    min-height: 56px;
}
#card_header_jobs QLabel, #card_header_company QLabel, #card_header_contractor QLabel, #card_header_user QLabel, #card_header_job_info QLabel, #card_header_client_info QLabel, #card_header_work_types QLabel, #card_header_materials QLabel, #card_header_expense QLabel {
    color: #1C2B3A;               /* MUDANÇA: texto azul-marinho escuro (já que o fundo agora é branco) */
    font-size: 15px;
    font-weight: 700;
    background-color: transparent;
}

/* ══════════════════════════════════════════════════════════════
   BARRAS DE ROLAGEM (scrollbars)
   ══════════════════════════════════════════════════════════════ */
QScrollBar:vertical { background: #F0F4F8; width: 8px; border-radius: 4px; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 4px; min-height: 30px; }  /* &quot;pegador&quot; da barra */
QScrollBar::handle:vertical:hover { background: #90A4AE; }                                  /* escurece no hover */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }               /* remove as setinhas de cima/baixo */
QScrollBar:horizontal { background: #F0F4F8; height: 8px; border-radius: 4px; }
QScrollBar::handle:horizontal { background: #CBD5E1; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }            /* remove as setinhas de esquerda/direita */

/* ══════════════════════════════════════════════════════════════
   BARRA DE STATUS (rodapé da janela) + campo de data
   ══════════════════════════════════════════════════════════════ */
QStatusBar { background-color: #1C2B3A; color: #8AAEC8; font-size: 12px; padding: 2px 10px; }
QDateEdit {
    background-color: #F5F8FC;
    color: #1C2B3A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 13px;
}
QDateEdit:focus { border: 1px solid #1E88E5; background-color: #FFFFFF; }




QScrollArea#scroll_job_form {
    background-color: #F0F4F8;
    border: none;
}
QScrollArea#scroll_job_form &gt; QWidget {
    background-color: #F0F4F8;
    border: none;
}
QScrollArea#scroll_job_form &gt; QWidget &gt; QWidget {
    background-color: #F0F4F8;
    border: none;
}
QDateEdit::drop-down { border: none; width: 22px; }</string>
